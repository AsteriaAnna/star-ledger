{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ledger Native Probe",
  "version": "0.1.0",
  "identifier": "app.asteria.ledgerprobe",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Ledger Native Probe", "width": 640, "height": 540 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
